---
/**
 * 01 — Identity. The primary mark large with the stardust turning over it,
 * the two logos stacked beside. Only the outer corners of the group are
 * rounded — the cards meet the outer radius, not each other's.
 */
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Starfield from '../Starfield.astro';
import Logotype from './Logotype.astro';

interface Item {
	image: ImageMetadata;
	alt: string;
	label?: string;
	video?: string;
}

interface Props {
	primary: Item & { stars: boolean };
	side: Item[];
	logotype?: string;
	title: string;
}

const { primary, side, logotype, title } = Astro.props;
---

<div class="identity unmask" data-reveal>
	<figure class="card card--primary">
		<Media image={primary.image} alt={primary.alt} video={primary.video} sizes="(max-width: 820px) 100vw, 62vw" />
		{primary.stars && <Starfield />}
		{
			logotype && (
				<div class="identity__logotype">
					<Logotype name={logotype} title={title} />
				</div>
			)
		}
	</figure>
	<div class="side">
		{
			side.map((item) => (
				<figure class="card">
					<Media image={item.image} alt={item.alt} video={item.video} sizes="(max-width: 820px) 100vw, 31vw" />
					{item.label && <figcaption class="card__label">{item.label}</figcaption>}
				</figure>
			))
		}
	</div>
</div>

<style lang="scss">
	@use '../../styles/tokens' as *;

	.identity {
		display: flex;
		gap: k(24);
		height: k(640);
		border-radius: k(40);
		overflow: hidden;
		isolation: isolate;

		@include mobile {
			flex-direction: column;
			height: auto;
			gap: 12px;
			border-radius: 20px;
		}
	}

	.card {
		position: relative;
		overflow: hidden;

		> :global(.media) {
			position: absolute;
			inset: 0;
		}
	}

	.card--primary {
		flex: 1 1 0;

		@include mobile {
			flex: none;
			aspect-ratio: 896 / 640;
		}
	}

	.side {
		flex: 0 0 k(440);
		display: flex;
		flex-direction: column;
		gap: k(24);

		.card {
			flex: 1 1 0;
		}

		@include mobile {
			flex: none;
			flex-direction: row;
			gap: 12px;

			.card {
				aspect-ratio: 440 / 308;
			}
		}
	}

	.card__label {
		position: absolute;
		left: k(16, 12);
		top: k(16, 12);
		@include mono(12, 10);
	}

	// The logotype sits a touch below centre, as in the file (y 320 of 640
	// for the text box, the letters lower inside it).
	.identity__logotype {
		position: absolute;
		left: 50%;
		top: 51.2%;
		width: calc(475 / 896 * 108 / 139 * 100%);
		transform: translateX(-50%);
		color: rgb(27 27 27 / 0.77);
	}
</style>
