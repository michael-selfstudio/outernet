---
/**
 * Every picture on the site. AVIF and WebP in the widths the layout can ask
 * for, a blurred copy of itself underneath while it loads, and an optional
 * looping clip on top once the clip can play.
 *
 * `sizes` is required on purpose: the layout is fluid (see k() in
 * _tokens.scss), so only the caller knows how wide the slot is.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { placeholder } from '@/lib/placeholder';

interface Props {
	image: ImageMetadata;
	alt: string;
	sizes: string;
	video?: string;
	/** Above the fold: fetch at once, decode with priority. */
	eager?: boolean;
	class?: string;
}

const { image, alt, sizes, video, eager = false, class: className } = Astro.props;
const blur = await placeholder(image);
const widths = [480, 720, 960, 1280, 1600, 2048, 2720].filter((w) => w <= image.width);
if (!widths.includes(image.width) && image.width < 2720) widths.push(image.width);
---

<div class:list={['media', className]} style={blur ? `--blur: url(${blur})` : undefined}>
	<Picture
		src={image}
		alt={alt}
		widths={widths}
		sizes={sizes}
		formats={['avif', 'webp']}
		fallbackFormat="jpg"
		quality={78}
		loading={eager ? 'eager' : 'lazy'}
		decoding={eager ? 'sync' : 'async'}
		fetchpriority={eager ? 'high' : undefined}
	/>
	{
		video && (
			<video class="media__video" src={video} muted loop playsinline preload="none" aria-hidden="true" data-autoplay />
		)
	}
</div>

<style lang="scss">
	@use '../styles/tokens' as *;

	.media {
		position: relative;
		overflow: hidden;
		background: var(--blur, transparent) center / cover no-repeat;

		:global(picture),
		:global(img),
		.media__video {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		:global(img) {
			transition: opacity 900ms $settle;
		}

		// Until an image has decoded it is transparent, and the blur shows.
		// Only with scripts on: without them nothing would ever reveal it.
		:global(html.js) & :global(img:not([data-loaded])) {
			opacity: 0;
		}

		.media__video {
			position: absolute;
			inset: 0;
			opacity: 0;
			transition: opacity 1200ms $settle;

			&[data-playing] {
				opacity: 1;
			}
		}
	}
</style>
